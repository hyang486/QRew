{
  "expo": {
    "name": "Qrew",
    "slug": "moment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moment",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.iyaproject.moment",
      "supportsTablet": false,
      "infoPlist": {
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Qrewing",
            "INAlternativeAppNamePronunciationHint": "crew-ing"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF3E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.iyaproject.moment"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF3E6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#FAF3E6",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Qrew uses the camera to scan room invite QR codes, to take photos for your room, and, only if you turn on face matching, to take your face reference photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Qrew reads the original photos and videos you choose so they can be shared at full quality in your room.",
          "cameraPermission": "Qrew uses the camera to scan room invite QR codes, to take photos for your room, and, only if you turn on face matching, to take your face reference photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Qrew reads the original photos and videos you choose so they can be shared at full quality in your room.",
          "savePhotosPermission": "Qrew saves the originals you download from a room to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qrew shows your position to your room only while you share it during an activity and the app is open.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-maps",
      "expo-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    }
  }
}
